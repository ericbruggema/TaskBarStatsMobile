    <string name="perm_notif_name">Notifications</string>
    <string name="perm_notif_why">For the live notification (also on the lock screen) and the alerts.</string>
    <string name="perm_overlay_name">Display over other apps</string>
    <string name="perm_overlay_why">Needed for the tiny figures in the status bar. In the list, pick TaskBarStatsMobile and switch it on.</string>
    <string name="perm_usage_name">Usage access</string>
    <string name="perm_usage_why">Lets the app read data use per day and per app, storage per app and screen time. Pick TaskBarStatsMobile in the list and switch it on. The data never leaves your device.</string>
    <string name="perm_battery_name">Battery optimisation</string>
    <string name="perm_battery_why">Some phones stop the live monitor to save power. In the list pick All apps, find TaskBarStatsMobile and choose Don\'t optimise. On Samsung phones also remove TaskBarStatsMobile from Sleeping apps (Settings > Battery > Background usage limits).</string>
    <string name="perm_shizuku_name">Shizuku (CPU and processes)</string>
    <string name="perm_shizuku_why">Unlocks CPU usage and the process list. Shizuku is a separate app that gives other apps limited shell access once you start it.</string>
    <string name="perm_allpkgs_name">See installed apps</string>
    <string name="perm_allpkgs_why">Granted automatically when installing. Used to show app names in the traffic, storage and autostart lists.</string>
